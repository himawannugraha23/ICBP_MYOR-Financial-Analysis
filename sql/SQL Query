-- MODULE 05: CASH FLOW ANALYSIS
-- =====================================================

-- QUERY 1: OPERATING CASH FLOW TREND

SELECT
    company,
    fiscal_year,
    cfo

FROM
    `financial-analyst-515705.financial_analyst.raw_financials_clean`

ORDER BY company, fiscal_year;


-- QUERY 2: FREE CASH FLOW

SELECT
    company,
    fiscal_year,
    cfo,
    capex_ppe,

    cfo - capex_ppe AS free_cash_flow

FROM
    `financial-analyst-515705.financial_analyst.raw_financials_clean`

ORDER BY company, fiscal_year;


-- QUERY 3: CFO TO NET INCOME

SELECT
    company,
    fiscal_year,
    cfo,
    profit_for_year,

    ROUND(
        SAFE_DIVIDE(cfo, profit_for_year),
        2
    ) AS cfo_to_net_income

FROM
    `financial-analyst-515705.financial_analyst.raw_financials_clean`

ORDER BY company, fiscal_year;


-- QUERY 4: CASH FLOW BENCHMARKING

SELECT
    company,

    SUM(cfo) AS total_operating_cash_flow,
    SUM(capex_ppe) AS total_capex,
    SUM(cfo - capex_ppe) AS total_free_cash_flow,

    ROUND(AVG(cfo), 2) AS avg_annual_cfo

FROM
    `financial-analyst-515705.financial_analyst.raw_financials_clean`

GROUP BY company;


