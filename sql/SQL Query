        PARTITION BY company
        ORDER BY fiscal_year
    ) AS previous_sales,

    ROUND(
        SAFE_DIVIDE(
            net_sales - LAG(net_sales) OVER (
                PARTITION BY company
                ORDER BY fiscal_year
            ),
            LAG(net_sales) OVER (
                PARTITION BY company
                ORDER BY fiscal_year
            )
        ) * 100,
        2
    ) AS revenue_growth_pct

FROM
    `financial-analyst-515705.financial_analyst.raw_financials_clean`

ORDER BY
    company,
    fiscal_year;


